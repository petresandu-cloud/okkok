{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.json",
  "name": "io.github.petresandu-cloud/okkok",
  "description": "Audit a built iOS or Android app against the App Store and Google Play rules. Facts from the binaries, verdicts with provenance, judgement questions for the model.",
  "repository": {"url": "https://github.com/petresandu-cloud/okkok", "source": "github"},
  "version": "0.1.1",
  "packages": [
    {
      "registry_type": "pypi",
      "identifier": "okkok",
      "version": "0.1.1",
      "runtime_hint": "python",
      "transport": {"type": "stdio"},
      "package_arguments": [{"type": "positional", "value": "-m"}, {"type": "positional", "value": "okkok.mcp_server"}]
    }
  ]
}
